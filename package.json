{
    "private": true,
    "workspaces": {
        "packages": [
            "platform/core/*",
            "platform/packages/*",
            "platform/plugins/*",
            "platform/themes/*"
        ]
    },
    "scripts": {
        "dev": "node vite-build.mjs",
        "development": "node vite-build.mjs",
        "prod": "cross-env NODE_ENV=production node vite-build.mjs",
        "production": "cross-env NODE_ENV=production node vite-build.mjs",
        "screenshot": "node platform/core/base/resources/js/screenshot.js",
        "admin-screenshot": "node platform/core/base/resources/js/admin-screenshot.js"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.9",
        "autoprefixer": "^10.6.1",
        "cross-env": "^10.1.0",
        "cssnano": "^9.1.2",
        "esbuild": "^0.28.2",
        "postcss": "^8.5.28",
        "postcss-prefix-custom-properties": "^0.1.0",
        "prettier": "^3.9.9",
        "puppeteer": "^25.12.0",
        "rtlcss": "^4.3.0",
        "sass": "^1.105.1",
        "vite": "^8.3.1"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "bootstrap": "5.3.8",
        "cropperjs": "^1.6.3",
        "epic-spinners": "^2.0.0",
        "jquery": "4.0.0",
        "lodash": "^4.18.1",
        "moment": "^2.31.0",
        "sanitize-html": "^2.18.0",
        "tiny-emitter": "^2.1.0",
        "vue": "^3.5.43"
    },
    "allowScripts": {
        "esbuild": true,
        "puppeteer": true,
        "@parcel/watcher": true
    }
}
